# Adonis environment — copy this file to `.env` and fill in your own values.
# This project is fully self-contained; do not reuse credentials from any
# other project.

# From your Supabase project: Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: USDA FoodData Central API key for better food text search.
# Free at https://fdc.nal.usda.gov/api-key-signup.html (DEMO_KEY works for light use).
EXPO_PUBLIC_USDA_API_KEY=
